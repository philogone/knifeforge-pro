  "narrative": {
    "northStar": "Le carnet du coutelier",
    "overview": "KnifeForge Pro is a knifemaker's workshop notebook: warm paper on a faint graph grid, warm graphite ink, and one patinated olive action colour. Technical first: dimensions, drawings and stock counts are always legible, aligned and exact. The warmth lives in the material: paper tone, IBM Plex Sans, and the maker's own vocabulary.",
    "keyCharacteristics": [
      "Warm graphite neutrals on paper; white sheets with a hairline edge, no shadows in flow.",
      "One action colour, olive: primary buttons, active nav, canvas selection, links.",
      "IBM Plex Sans throughout, self-hosted; Plex Mono only for ruler figures.",
      "Figures in the reader's convention; tabular numerals in tables.",
      "One drawn icon set; no emoji or glyph icons."
    ],
    "rules": [
      {
        "name": "The Layer Colour Is Meaning Rule",
        "body": "On the drawing and client plan, a stroke's colour and dash identify its layer role. Never reuse them decoratively.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "Indigo is the only accent. Status colours speak only for state.",
        "section": "colors"
      },
      {
        "name": "The Small And Exact Rule",
        "body": "Body 14 px, labels 12 px, never below 12 px. Dimensions are never truncated or rounded for display beyond their stored precision.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Nothing in the page flow casts a shadow; only dialogs and menus do. Use a hairline border to separate.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do start every management page with .page-head: title, one-line lead, one primary action.",
      "Do put the list first and open forms on demand; every field has a visible label.",
      "Do format every number through the @/i18n helpers; tabular numerals in tables.",
      "Do confirm destructive actions by naming the item; errors are inline and translated.",
      "Do flag what blocks nesting in caution amber, with a link to fix it."
    ],
    "donts": [
      "Don't add shadows to sheets, buttons or inputs.",
      "Don't use emoji or Unicode glyphs as icons.",
      "Don't use layer colours for chrome inside the editor.",
      "Don't set text lighter than Graphite Muted, or smaller than 12 px.",
      "Don't write \"$\"; the workshop prices in euros."
    ]
  }
