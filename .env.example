# =============================================================================
# KnifeForge Manager — environment configuration
# Copy this file to `.env` and fill in real values before running
# `docker compose up -d`. Never commit the real `.env` file.
# =============================================================================

ENVIRONMENT=production
DEBUG=false

FRONTEND_URL=http://localhost:8080
HTTP_PORT=8080

# Random secret used to sign admin JWT session tokens. Generate with:
# openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Database -------------------------------------------------------
POSTGRES_USER=knifeforge
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=knifeforge
# Host port for Postgres (change if 5432 is already used by another local stack)
DB_HOST_PORT=5432

# --- Admin account -------------------------------------------------------
ADMIN_EMAIL=admin@example.com

# Bcrypt hash of the admin password — NEVER put the plaintext password here.
# Generate it with:
#   docker compose run --rm backend python scripts/hash_password.py "YourStrongPassword"
#
# IMPORTANT: a bcrypt hash contains literal "$" characters (e.g. $2b$12$...).
# Docker Compose treats "$" in a .env file as a variable reference and will
# silently strip it, corrupting the hash. Double every "$" into "$$" when
# pasting the hash below, e.g. ADMIN_PASSWORD_HASH=$$2b$$12$$RRlpfX93...
ADMIN_PASSWORD_HASH=

# --- Mock / demo data ------------------------------------------------------------
# If true, a demo material catalog, treatment recipes (heat treat + damascus
# etch + patina), knife models, and orders in different lifecycle states are
# seeded automatically on backend startup. Turn this off once you have real
# data, or manage it from the admin panel (Settings > Demo data).
SEED_MOCK_DATA_ON_STARTUP=true

# --- Outgoing mail (optional) ----------------------------------------------------
# The workshop's own mail account, to send quotes, invoices and payment reminders
# from KnifeForge (Settings > E-mail shows the state and sends a test message).
# Most providers want an "app password", not your usual one. SECURITY: starttls,
# ssl or none. SMTP_FROM: the sender address, the user name when empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
